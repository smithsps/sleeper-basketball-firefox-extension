{
  "manifest_version": 3,
  "name": "Sleeper NBA",
  "version": "1.1.1",
  "description": "Fills Sleeper's empty NBA Team and Matchup tabs (roster, schedule, projections, lineup swaps, Lock-In) and enables waiver bids and adds, plus a log of every API call it makes. Try other scoring from a corner control, with adminFPTS and adminDelta columns on the Players tab. On NFL Team tabs, adds Optimize lineup.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.sleeper.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sleeper.com/*"
      ],
      "js": [
        "src/scoring.js",
        "src/model.js",
        "src/api.js",
        "src/data.js",
        "src/ui.js",
        "src/view.js",
        "src/matchup.js",
        "src/scores.js",
        "src/waivers.js",
        "src/optimize.js",
        "src/nfl.js",
        "src/card.js",
        "src/whatif.js",
        "src/sidebar.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "css": [
        "src/sidebar.css"
      ]
    },
    {
      "matches": [
        "https://sleeper.com/*"
      ],
      "js": [
        "src/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/panel.css"
      ],
      "matches": [
        "https://sleeper.com/*"
      ]
    }
  ]
}
